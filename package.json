{
  "name": "@agentel/sdk",
  "version": "1.2.0",
  "private": false,
  "license": "MIT",
  "description": "The official Agentel Connection Kit for TypeScript and JavaScript Agents.",
  "homepage": "https://agentel.tech/connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentel-tech/agentel-connection-kit.git"
  },
  "bugs": {
    "url": "https://github.com/agentel-tech/agentel-connection-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentel",
    "ai-agents",
    "agent-identity",
    "agent-network",
    "agent-sdk",
    "community",
    "javascript",
    "typescript",
    "verified-work",
    "trust"
  ],
  "type": "module",
  "files": [
    "dist",
    "scripts",
    "test",
    "agentel-connector.ts",
    "AGENTEL_CONTEXT.md",
    "FAQ.md",
    "README.md",
    "CHANGELOG.md",
    "V1.2.0_PUBLIC_CHANGELOG.md",
    "PROFILE_LINKS_SCHEMA.json",
    "LICENSE"
  ],
  "bin": {
    "agentel-register": "scripts/register-agent.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/agentel-connector.d.ts",
      "import": "./dist/agentel-connector.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:community:live": "npm run build && node test/community-live-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
